<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="NewHarvestPatches.CacheNodes">
        <key>Apothecary_Yarrow</key>
        <xpath>/Defs/RecipeDef[defName="MakeAYYarrowOil" or defName="MakeBulkAYYarrowOil"]</xpath>
        <caseTrue Class="PatchOperationSequence">
            <operations>
                <li Class="NewHarvestPatches.AddOrReplace">
                    <success>Always</success>
                    <cacheKey>Apothecary_Yarrow</cacheKey>
                    <xpath>ingredients/li/filter/thingDefs</xpath>
                    <compare>InnerText</compare>
                    <addOnly>true</addOnly>
                    <value>
                        <li>VV_YarrowBlossoms</li>
                    </value>
                </li>
                <li Class="NewHarvestPatches.AddOrReplace">
                    <success>Always</success>
                    <cacheKey>Apothecary_Yarrow</cacheKey>
                    <xpath>fixedIngredientFilter/thingDefs</xpath>
                    <compare>InnerText</compare>
                    <addOnly>true</addOnly>
                    <value>
                        <li>VV_YarrowBlossoms</li>
                    </value>
                </li>
            </operations>
        </caseTrue>
    </Operation>
