<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- VBE -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Brewing Expanded</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="NewHarvestPatches.CacheNodes">
                    <key>AC_Med_Kombucha</key>
                    <xpath>/Defs/RecipeDef[defName="AC_BrewFlavouredKombucha"]</xpath>
                    <caseTrue Class="PatchOperationSequence">
                        <operations>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>AC_Med_Kombucha</cacheKey>
                                <xpath>ingredients/li[@Name="FruitIngredient"]/filter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_ChamomileBlossoms</li>
                                    <li>VV_LavenderBlossoms</li>
                                    <li>VV_LemonBalmLeaves</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>AC_Med_Kombucha</cacheKey>
                                <xpath>fixedIngredientFilter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_ChamomileBlossoms</li>
                                    <li>VV_LavenderBlossoms</li>
                                    <li>VV_LemonBalmLeaves</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>AC_Med_Kombucha</cacheKey>
                                <xpath>defaultIngredientFilter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_ChamomileBlossoms</li>
                                    <li>VV_LavenderBlossoms</li>
                                    <li>VV_LemonBalmLeaves</li>
                                </value>
                            </li>
                        </operations>
                    </caseTrue>
                </li>
                <li Class="NewHarvestPatches.CacheNodes">
                    <key>AC_Med_TeaSachets</key>
                    <xpath>/Defs/RecipeDef[defName="AC_PrepareSpecialtyTeaSachets"]</xpath>
                    <caseTrue Class="PatchOperationSequence">
                        <operations>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>AC_Med_TeaSachets</cacheKey>
                                <xpath>ingredients/li[@Name="FruitIngredient"]/filter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_ChamomileBlossoms</li>
                                    <li>VV_LavenderBlossoms</li>
                                    <li>VV_LemonBalmLeaves</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>AC_Med_TeaSachets</cacheKey>
                                <xpath>fixedIngredientFilter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_ChamomileBlossoms</li>
                                    <li>VV_LavenderBlossoms</li>
                                    <li>VV_LemonBalmLeaves</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>AC_Med_TeaSachets</cacheKey>
                                <xpath>defaultIngredientFilter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_ChamomileBlossoms</li>
                                    <li>VV_LavenderBlossoms</li>
                                    <li>VV_LemonBalmLeaves</li>
                                </value>
                            </li>
                        </operations>
                    </caseTrue>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
