                                    <li>VV_Papayas</li>
                                    <li>VV_Persimmons</li>
                                    <li>VV_Pomegranates</li>
                                    <li>VV_Quinces</li>
                                    <li>VV_SourCherrys</li>
                                    <li>VV_CherryPlums</li>
                                    <li MayRequire="dankpyon.medieval.overhaul">VV_WhiteMulberries</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>AC_Trees_Kombucha</cacheKey>
                                <xpath>fixedIngredientFilter/thingDefs</xpath>
