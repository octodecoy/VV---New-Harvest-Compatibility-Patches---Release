                    <value>
                        <li>VV_CedarWood</li>
                        <li>VV_EbonyWood</li>
                        <li>VV_MahoganyWood</li>
                        <li>VV_RosewoodWood</li>
                        <li>VV_LacqueredWood</li>
                    </value>
                </li>
            </operations>
