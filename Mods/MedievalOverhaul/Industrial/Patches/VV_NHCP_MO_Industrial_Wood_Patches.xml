                <li Class="PatchOperationReplace">
                    <success>Always</success>
                    <xpath>                        
                        /Defs/ThingDef[
                        defName="VV_EbonyWood" or 
                        defName="VV_MahoganyWood" or 
                        defName="VV_RosewoodWood" or 
                        defName="VV_CedarWood" or
                        defName="VV_LacqueredWood"]
                        /thingCategories
                        [not(li="DankPyon_Wood")]
                        /li[text()="ResourcesRaw"]/text()
                    </xpath>
                    <value>DankPyon_Wood</value>
                </li>
                <li Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>                        
                        /Defs/ThingDef[
                        defName="VV_EbonyWood" or 
                        defName="VV_MahoganyWood" or 
                        defName="VV_RosewoodWood" or 
                        defName="VV_CedarWood" or
                        defName="VV_LacqueredWood"]
