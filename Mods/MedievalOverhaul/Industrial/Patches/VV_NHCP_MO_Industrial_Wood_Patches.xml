                        <li>DankPyon_RawDarkWood</li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>/Defs/RecipeDef[defName="VV_MakeLacqueredWood" or defName="VV_MakeLacqueredWoodBulk"][not(fixedIngredientFilter)]</xpath>
                    <value>
                        <fixedIngredientFilter />
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>/Defs/RecipeDef[defName="VV_MakeLacqueredWood" or defName="VV_MakeLacqueredWoodBulk"]/fixedIngredientFilter[not(thingDefs)]</xpath>
                    <value>
                        <thingDefs />
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>/Defs/RecipeDef[defName="VV_MakeLacqueredWood" or defName="VV_MakeLacqueredWoodBulk"]/fixedIngredientFilter/thingDefs[not(li="DankPyon_RawDarkWood")]</xpath>
