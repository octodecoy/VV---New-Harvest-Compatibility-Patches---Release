                        <harvestedThingDef>DankPyon_Log_VV_RosewoodWood</harvestedThingDef>
                    </value>
                </li>
                <!-- RECIPE TO MAKE LACQUERED PLANKS -->
                <li Class="NewHarvestPatches.EditString">
                    <xpath>/Defs/RecipeDef[defName="VV_MakeLacqueredWood" or defName="VV_MakeLacqueredWoodBulk"]/label</xpath>
                    <mode>ReplaceSubstring</mode>
                    <target>wood</target>
                    <value>timber</value>
                </li>
                <li Class="NewHarvestPatches.EditString">
                    <xpath>/Defs/RecipeDef[defName="VV_MakeLacqueredWood" or defName="VV_MakeLacqueredWoodBulk"]/description</xpath>
                    <mode>ReplaceSubstring</mode>
                    <target>wood</target>
                    <value>timber</value>
                </li>
                <li Class="NewHarvestPatches.EditString">
                    <xpath>/Defs/RecipeDef[defName="VV_MakeLacqueredWood" or defName="VV_MakeLacqueredWoodBulk"]/jobString</xpath>
                    <mode>ReplaceSubstring</mode>
                    <target>wood</target>
                    <value>timber</value>
                </li>
                <!-- Only existant if chain is on -->
