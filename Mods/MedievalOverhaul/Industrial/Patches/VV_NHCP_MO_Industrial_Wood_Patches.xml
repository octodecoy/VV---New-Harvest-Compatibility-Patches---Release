        <!-- Lumber Chain OFF -->
        <nomatch Class="PatchOperationSequence">
            <operations>
                <!-- RECIPE TO MAKE LACQUERED WOOD -->
                <li Class="PatchOperationAdd">
                    <success>Always</success>
                    <xpath>/Defs/RecipeDef[defName="VV_MakeLacqueredWood" or defName="VV_MakeLacqueredWoodBulk"]/ingredients/li[1]/filter/thingDefs[not(li="DankPyon_RawDarkWood")]</xpath>
