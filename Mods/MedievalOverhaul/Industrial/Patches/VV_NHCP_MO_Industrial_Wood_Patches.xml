                <li Class="NewHarvestPatches.AddDefsWhereDefPresent">
                    <success>Always</success>
                    <xpath>
                        /Defs/ThingDef[defName="DankPyon_BarrelWoodLog"]/building/fixedStorageSettings/filter/thingDefs
                        | /Defs/ThingDef[defName="DankPyon_BarrelWoodLog"]/building/defaultStorageSettings/filter/thingDefs
                    </xpath>
                    <anchor>DankPyon_RawWood</anchor>
                    <value>
                        <li>DankPyon_Log_VV_CedarWood</li>
                        <li>DankPyon_Log_VV_EbonyWood</li>
                        <li>DankPyon_Log_VV_MahoganyWood</li>
                        <li>DankPyon_Log_VV_RosewoodWood</li>
                    </value>
                </li>
                <!-- RECIPES - DISALLOWED -->
                <!-- mirrorFixedIngredientFilter creates fixedIngredientFilter/disallowedThingDefs when absent
                     too, closing a gap the old two-op version had (it required that filter to pre-exist). -->
                <li Class="NewHarvestPatches.AddDefsWhereDefPresent">
                    <success>Always</success>
                    <xpath>/Defs/RecipeDef/ingredients/li/filter/disallowedThingDefs</xpath>
                    <anchor>WoodLog</anchor>
                    <mirrorFixedIngredientFilter>true</mirrorFixedIngredientFilter>
                    <value>
                        <li>DankPyon_Log_VV_CedarWood</li>
                        <li>DankPyon_Log_VV_EbonyWood</li>
                        <li>DankPyon_Log_VV_MahoganyWood</li>
                        <li>DankPyon_Log_VV_RosewoodWood</li>
                    </value>
                </li>
                <!-- RECIPES - ALLOWED -->
                <!-- fixedIngredientFilter mirror only ever covered non-Bulk Tar - kept asymmetric on purpose,
                     not promoted to a mirror flag which would also widen TarBulk's fixedIngredientFilter. -->
                <li Class="NewHarvestPatches.AddDefsWhereDefPresent">
                    <success>Always</success>
                    <xpath>
                        /Defs/RecipeDef
                        [defName="DankPyon_Make_Tar" or defName="DankPyon_Make_TarBulk"]
                        /ingredients/li/filter/thingDefs
                    </xpath>
                    <anchor>WoodLog</anchor>
                    <value>
                        <li>DankPyon_Log_VV_CedarWood</li>
                        <li>DankPyon_Log_VV_EbonyWood</li>
                        <li>DankPyon_Log_VV_MahoganyWood</li>
                        <li>DankPyon_Log_VV_RosewoodWood</li>
                    </value>
                </li>
                <li Class="NewHarvestPatches.AddDefsWhereDefPresent">
                    <success>Always</success>
                    <xpath>/Defs/RecipeDef[defName="DankPyon_Make_Tar"]/fixedIngredientFilter/thingDefs</xpath>
                    <anchor>WoodLog</anchor>
                    <value>
                        <li>DankPyon_Log_VV_CedarWood</li>
                        <li>DankPyon_Log_VV_EbonyWood</li>
                        <li>DankPyon_Log_VV_MahoganyWood</li>
                        <li>DankPyon_Log_VV_RosewoodWood</li>
                    </value>
                </li>
