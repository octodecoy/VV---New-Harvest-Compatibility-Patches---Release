<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Fruit Plants</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="NewHarvestPatches.CacheNodes">
                    <key>VBE_MixJuiceBase_FP</key>
                    <xpath>/Defs/RecipeDef[@Name="VBE_MixJuiceBase"][not(fixedIngredientFilter/categories/li[text()="VV_NHCP_DummyCategory_Fruit"])]</xpath>
                    <caseTrue Class="PatchOperationSequence">
                        <operations>
                            <li Class="PatchOperationAdd">
                                <xpath>/Defs/RecipeDef[defName="VBE_MixJuice"]/ingredients/li/filter/thingDefs</xpath>
                                <value>
                                    <li>VV_Blackberries</li>
                                    <li>VV_Blackcurrants</li>
                                    <li>VV_DragonFruits</li>
                                    <li>VV_Rosehips</li>
                                    <li>VV_Cranberries</li>
                                    <li>VV_AppleCactusFruits</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>VBE_MixJuiceBase_FP</cacheKey>
                                <xpath>fixedIngredientFilter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_Blackberries</li>
                                    <li>VV_Blackcurrants</li>
                                    <li>VV_DragonFruits</li>
                                    <li>VV_Rosehips</li>
                                    <li>VV_Cranberries</li>
                                    <li>VV_AppleCactusFruits</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>VBE_MixJuiceBase_FP</cacheKey>
                                <xpath>defaultIngredientFilter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_Blackberries</li>
                                    <li>VV_Blackcurrants</li>
                                    <li>VV_DragonFruits</li>
                                    <li>VV_Rosehips</li>
                                    <li>VV_Cranberries</li>
                                    <li>VV_AppleCactusFruits</li>
                                </value>
                            </li>
                        </operations>
                    </caseTrue>
                </li>
                <li Class="NewHarvestPatches.CacheNodes">
                    <key>VBE_MakeGinMush_FP</key>
                    <xpath>/Defs/RecipeDef[defName="VBE_MakeGinMush"]</xpath>
                    <caseTrue Class="PatchOperationSequence">
                        <operations>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>VBE_MakeGinMush_FP</cacheKey>
                                <xpath>ingredients/li/filter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_Blackberries</li>
                                    <li>VV_Blackcurrants</li>
                                    <li>VV_Cranberries</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>VBE_MakeGinMush_FP</cacheKey>
                                <xpath>fixedIngredientFilter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_Blackberries</li>
                                    <li>VV_Blackcurrants</li>
                                    <li>VV_Cranberries</li>
                                </value>
                            </li>
                            <li Class="NewHarvestPatches.AddOrReplace">
                                <success>Always</success>
                                <cacheKey>VBE_MakeGinMush_FP</cacheKey>
                                <xpath>defaultIngredientFilter/thingDefs</xpath>
                                <compare>InnerText</compare>
                                <addOnly>true</addOnly>
                                <value>
                                    <li>VV_Blackberries</li>
                                    <li>VV_Blackcurrants</li>
                                    <li>VV_Cranberries</li>
                                </value>
                            </li>
                        </operations>
                    </caseTrue>
                </li>
                <li Class="PatchOperationFindMod">
                    <mods>
                        <li>Vanilla Plants Expanded</li>
                    </mods>
                    <match Class="NewHarvestPatches.CacheNodes">
                        <key>VBE_MakeUnfermentedCider_FP</key>
                        <xpath>/Defs/RecipeDef[defName="VBE_MakeUnfermentedCider"]</xpath>
                        <caseTrue Class="PatchOperationSequence">
                            <operations>
                                <li Class="NewHarvestPatches.AddOrReplace">
                                    <success>Always</success>
                                    <cacheKey>VBE_MakeUnfermentedCider_FP</cacheKey>
                                    <xpath>ingredients/li/filter/thingDefs</xpath>
                                    <compare>InnerText</compare>
                                    <addOnly>true</addOnly>
                                    <value>
                                        <li>VV_DragonFruits</li>
                                    </value>
                                </li>
                                <li Class="NewHarvestPatches.AddOrReplace">
                                    <success>Always</success>
                                    <cacheKey>VBE_MakeUnfermentedCider_FP</cacheKey>
                                    <xpath>fixedIngredientFilter/thingDefs</xpath>
                                    <compare>InnerText</compare>
                                    <addOnly>true</addOnly>
                                    <value>
                                        <li>VV_DragonFruits</li>
                                    </value>
                                </li>
                                <li Class="NewHarvestPatches.AddOrReplace">
                                    <success>Always</success>
                                    <cacheKey>VBE_MakeUnfermentedCider_FP</cacheKey>
                                    <xpath>defaultIngredientFilter/thingDefs</xpath>
                                    <compare>InnerText</compare>
                                    <addOnly>true</addOnly>
                                    <value>
                                        <li>VV_DragonFruits</li>
                                    </value>
                                </li>
                            </operations>
                        </caseTrue>
                    </match>
                </li>
            </operations>
        </match>
    </Operation>
