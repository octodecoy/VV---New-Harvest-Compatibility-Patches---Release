    <Operation Class="NewHarvestPatches.FindMod">
        <modGroupOne>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Medicinal Plants</li>
        </modGroupOne>
        <modGroupTwo>
            <li>Vanilla Brewing Expanded - Coffees and Teas</li>
        </modGroupTwo>
        <logicBetweenGroups>And</logicBetweenGroups>
        <caseTrue Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>/Defs/ThingDef[
                defName="VV_LindenTea" or
                defName="VV_ChamomileTea" or
                defName="VV_ThymeTea" or
                defName="VV_GinkgoTea" or
                defName="VV_GinsengDecoction" or
                defName="VV_EchinaceaDecoction" or
                defName="VV_ValerianDecoction" or
                defName="VV_WormwoodDecoction"]
                /recipeMaker/recipeUsers
                [not(li="VBE_EspressoMachineBuilding")]
            </xpath>
            <value>
                <li>VBE_EspressoMachineBuilding</li>
            </value>
        </caseTrue>
    </Operation>
