<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Mushrooms</li>           
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/RecipeDef[defName="Make_Fungalwort"]/ingredients/li/filter/thingDefs</xpath>
                    <value>
                        <li>VV_BlackTruffles</li>
                        <li>VV_KingBoletes</li>
                        <li>VV_Chanterelles</li>
                        <li>VV_Morels</li>
                        <li>VV_ParasolMushrooms</li>
                        <li>VV_OysterMushrooms</li>
                        <li>VV_ShiitakeMushrooms</li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/RecipeDef[defName="Make_Fungalwort"]/fixedIngredientFilter/thingDefs</xpath>
                    <value>
                        <li>VV_BlackTruffles</li>
                        <li>VV_KingBoletes</li>
                        <li>VV_Chanterelles</li>
                        <li>VV_Morels</li>
                        <li>VV_ParasolMushrooms</li>
                        <li>VV_OysterMushrooms</li>
                        <li>VV_ShiitakeMushrooms</li>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>