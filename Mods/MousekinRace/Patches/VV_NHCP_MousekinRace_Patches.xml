<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Forage Crops</li>
        </mods>  
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/TraderKindDef[@Name="Mousekin_TraderSettlementBase"]/stockGenerators</xpath>
                    <value>
                        <li Class="StockGenerator_SingleDef">
                            <thingDef>VV_AlfalfaHay</thingDef>
                            <countRange>250~1000</countRange>
                            <price>Cheap</price>
                        </li>
                        <li Class="StockGenerator_SingleDef">
                            <thingDef>VV_CloverHay</thingDef>
                            <countRange>250~1000</countRange>
                            <price>Cheap</price>
                        </li>
                        <li Class="StockGenerator_SingleDef">
                            <thingDef>VV_TimothyHay</thingDef>
                            <countRange>250~1000</countRange>
                            <price>Cheap</price>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/TraderKindDef[@Name="Mousekin_TraderCaravanBase"]/stockGenerators</xpath>
                    <value>
                        <li Class="StockGenerator_BuySingleDef">
                            <thingDef>VV_AlfalfaHay</thingDef>
                        </li>      
                        <li Class="StockGenerator_BuySingleDef">
                            <thingDef>VV_CloverHay</thingDef>
                        </li>  
                        <li Class="StockGenerator_BuySingleDef">
                            <thingDef>VV_TimothyHay</thingDef>
                        </li>                    
                    </value>
                </li>
            </operations>
        </match>    
    </Operation>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Medicinal Plants</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/ThingDef[defName="Mousekin_WorkbenchAlchemy"]</xpath>
                    <match Class="PatchOperationSequence">
                        <operations>
                            <li Class="PatchOperationAdd">
                                <xpath>
                                    /Defs/ThingDef
                                    [defName="VV_SoothingHerbalOintment" or 
                                    defName="VV_RestorativeHerbalOintment" or 
                                    defName="VV_AdvancedHerbalMedicine" or
                                    defName="VV_GinsengDecoction" or
                                    defName="VV_EchinaceaDecoction" or
                                    defName="VV_ValerianDecoction" or
                                    defName="VV_WormwoodDecoction"]
                                    /recipeMaker/recipeUsers
                                </xpath>
                                <value>
                                    <li>Mousekin_WorkbenchAlchemy</li>
                                </value>
                            </li>
                            <li Class="PatchOperationAdd">
                                <xpath>/Defs/WorkGiverDef[defName="VV_NHCP_DoBillsAlchemyCooking"]/fixedBillGiverDefs</xpath>
                                <value>
                                    <li>Mousekin_WorkbenchAlchemy</li>
                                </value>
                            </li>
                        </operations>
                    </match>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/MousekinRace.FlowerListDef[defName="Mousekin_ValidFlowers"]/flowerPlants</xpath>
                    <value>
                        <li>VV_CalendulaPlant</li>
                        <li>VV_ChamomilePlant</li>
                        <li>VV_EchinaceaPlant</li>
                        <li>VV_HawthornTree</li>
                        <li>VV_LavenderPlant</li>
                        <li>VV_LindenTree</li>
                        <li>VV_StJohnsWortPlant</li>
                        <li>VV_ThymePlant</li>
                        <li>VV_YarrowPlant</li>
                        <li>VV_WormwoodPlant</li>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Fruit Plants</li>
        </mods>  
        <match Class="PatchOperationAdd">
            <xpath>/Defs/MousekinRace.FlowerListDef[defName="Mousekin_ValidFlowers"]/flowerPlants</xpath>
            <value>
                <li>VV_BlackberryBush</li>
                <li>VV_BlackcurrantBush</li>
                <li>VV_CranberryBush</li>
            </value>
        </match>
    </Operation>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Trees</li>
        </mods>  
        <match Class="PatchOperationAdd">
            <xpath>/Defs/MousekinRace.FlowerListDef[defName="Mousekin_ValidFlowers"]/flowerPlants</xpath>
            <value>
                <li>VV_SourCherryTree</li>
                <li>VV_ApricotTree</li>
                <li>VV_ChestnutTree</li>
                <li>VV_SugarMapleTree</li>
                <li>VV_GrapefruitTree</li>
                <li>VV_LimeTree</li>
                <li>VV_CherryPlumTree</li>
            </value>
        </match>
    </Operation>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Flowers</li>
        </mods>  
        <match Class="PatchOperationAdd">
            <xpath>/Defs/MousekinRace.FlowerListDef[defName="Mousekin_ValidFlowers"]/flowerPlants</xpath>
            <value>
                <li>VV_Aubrieta</li>
                <li>VV_Begonia</li>
                <li>VV_CallaLily</li>
                <li>VV_Dymondia</li>
                <li>VV_Gerbera</li>
                <li>VV_Hydrangea</li>
                <li>VV_Lilac</li>
                <li>VV_Orchid</li>
                <li>VV_Petunia</li>
                <li>VV_Primrose</li>
                <li>VV_Tulip</li>
                <li>VV_Wisteria</li>
            </value>
        </match>
    </Operation>
</Patch>