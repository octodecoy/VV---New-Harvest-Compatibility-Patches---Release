<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="NewHarvestPatches.FindMod">
        <modGroupOne>
            <li>Vanilla Brewing Expanded</li>
        </modGroupOne>
        <modGroupTwo>
            <li>VV - New Harvest</li>
            <li>VV - New Harvest: Medicinal Plants</li>
        </modGroupTwo>
        <logicBetweenGroups>And</logicBetweenGroups>
        <caseTrue Class="PatchOperationAdd">
            <xpath>/Defs/AlphaMemes.TeaDefs[defName="AM_TeaDefs"]/specialtyTeas</xpath>
            <value>
                <li>VV_LindenTea</li>
                <li>VV_ChamomileTea</li>
                <li>VV_ThymeTea</li>
                <li>VV_GinkgoTea</li>
            </value>
        </caseTrue>
    </Operation>
</Patch>