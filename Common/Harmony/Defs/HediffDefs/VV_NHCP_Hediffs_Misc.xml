<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <HediffDef>
        <defName>VV_NHCP_NourishedPet</defName>
        <hediffClass>HediffWithComps</hediffClass>
        <label>Nourished</label>
        <description>Animal is nourished and will nuzzle more often.</description>
        <defaultLabelColor>(0.52, 1, 0.95)</defaultLabelColor>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>15000~60000</disappearsAfterTicks> <!-- Default 6-24 hours -->
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath" />
        </comps>
        <isBad>false</isBad>
    </HediffDef>
</Defs>