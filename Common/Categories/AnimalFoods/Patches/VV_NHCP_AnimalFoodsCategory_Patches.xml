<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Detect mod-added categories of this type, then do two things to every filter referencing one:
         add our dummy category (what makes the filter work while this kind's merge setting is ON) and
         name our own produce outright (what makes it work while merge is OFF). The category test is
         shared C# (SharedConstants.Category), so no category name is written in this file. The dummy
         category's defName is derived from categoryType in C# (GetCategoryName), and an already-listed
         dummy is recognised there too, so neither appears here as a literal. The ProcessorFramework arm
         needs no PatchOperationFindMod guard: without that mod the document holds no
         ProcessorFramework.ProcessDef nodes and the arm simply matches nothing.
         AnimalFoods is the one kind that CANNOT take its def list from the shared seed map: that entry
         also holds crafted feeds (VV_BeetPulp, VV_FodderMix, VV_ProteinKibble) which must never become
         ingredients, and the hays need the plant-food split below. Hence the explicit <value> lists,
         and hence the def-injection half stays split across several xpaths while the category half is
         one union.
         Everything per-def and setting-dependent (def membership, merging, category parenting,
         resource readout, trader stock) is applied live in C# by CategoryApplier/CategoryClassifier. -->
    <Operation Class="NewHarvestPatches.TestCategory">
        <xpath>/Defs/ThingCategoryDef[parent="Foods" or parent="FoodRaw" or parent="PlantFoodRaw"]</xpath>
        <categoryType>AnimalFoods</categoryType>
        <caseTrue Class="PatchOperationSequence">
            <operations>
                <li Class="NewHarvestPatches.AddCategoryToFilter">
                    <success>Always</success>
                    <categoryType>AnimalFoods</categoryType>
                    <xpath>
                        /Defs/RecipeDef/ingredients/li/filter/categories
                        | /Defs/RecipeDef/fixedIngredientFilter/categories
                        | /Defs/RecipeDef/defaultIngredientFilter/categories
                        | /Defs/ThingDef/building/fixedStorageSettings/filter/categories
                        | /Defs/ThingDef/building/defaultStorageSettings/filter/categories
                        | /Defs/ProcessorFramework.ProcessDef/ingredientFilter/categories
                    </xpath>
                </li>

                <!-- Slots a recipe author left open (the bill's own filter and its default): all six raw
                     feeds, hays included. -->
                <li Class="NewHarvestPatches.AddOwnDefsToCategoryFilters">
                    <success>Always</success>
                    <categoryType>AnimalFoods</categoryType>
                    <xpath>
                        /Defs/RecipeDef/ingredients/li/filter/categories
                        | /Defs/RecipeDef/defaultIngredientFilter/categories
                        | /Defs/ProcessorFramework.ProcessDef/ingredientFilter/categories
                    </xpath>
                    <value>
                        <li>VV_AlfalfaHay</li>
                        <li>VV_CloverHay</li>
                        <li>VV_TimothyHay</li>
                        <li>VV_FeedCorn</li>
                        <li>VV_FeedWheat</li>
                        <li>VV_FeedBeet</li>
                    </value>
                </li>

                <!-- fixedIngredientFilter is the hard boundary of what a recipe can ever accept, so the
                     two halves are split: the feed crops are plain plant food and always fit, while the
                     hays must not be forced into a recipe that deliberately disallows plant food. -->
                <li Class="NewHarvestPatches.AddOwnDefsToCategoryFilters">
                    <success>Always</success>
                    <categoryType>AnimalFoods</categoryType>
                    <xpath>/Defs/RecipeDef/fixedIngredientFilter/categories</xpath>
                    <value>
                        <li>VV_FeedCorn</li>
                        <li>VV_FeedWheat</li>
                        <li>VV_FeedBeet</li>
                    </value>
                </li>
                <li Class="NewHarvestPatches.AddOwnDefsToCategoryFilters">
                    <success>Always</success>
                    <categoryType>AnimalFoods</categoryType>
                    <xpath>/Defs/RecipeDef/fixedIngredientFilter[not(specialFiltersToDisallow/li="AllowPlantFood")]/categories</xpath>
                    <value>
                        <li>VV_AlfalfaHay</li>
                        <li>VV_CloverHay</li>
                        <li>VV_TimothyHay</li>
                    </value>
                </li>

                <!-- Storage has no plant-food distinction to respect. -->
                <li Class="NewHarvestPatches.AddOwnDefsToCategoryFilters">
                    <success>Always</success>
                    <categoryType>AnimalFoods</categoryType>
                    <xpath>
                        /Defs/ThingDef/building/fixedStorageSettings/filter/categories
                        | /Defs/ThingDef/building/defaultStorageSettings/filter/categories
                    </xpath>
                    <value>
                        <li>VV_AlfalfaHay</li>
                        <li>VV_CloverHay</li>
                        <li>VV_TimothyHay</li>
                        <li>VV_FeedCorn</li>
                        <li>VV_FeedWheat</li>
                        <li>VV_FeedBeet</li>
                    </value>
                </li>
            </operations>
        </caseTrue>
    </Operation>
</Patch>
