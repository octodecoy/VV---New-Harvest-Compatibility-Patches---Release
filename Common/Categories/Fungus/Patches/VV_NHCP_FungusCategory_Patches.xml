<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- Detect mod-added categories of this type, then do two things to every filter referencing one:
         add our dummy category (what makes the filter work while this kind's merge setting is ON) and
         name our own produce outright (what makes it work while merge is OFF). Both operations share
         one C# test and one C# def list in SharedConstants.Category, which is why no category name
         and no defName is written in this file. Everything per-def and setting-dependent (def
         membership, merging, category parenting, resource readout, trader stock) is applied live in
         C# by CategoryApplier/CategoryClassifier.
         Both operations also share one union xpath over every filter location we care about. The
         dummy category's defName is derived from categoryType in C# (GetCategoryName), and an
         already-listed dummy is recognised there too, so neither has to appear here as a literal.
         The ProcessorFramework arm needs no PatchOperationFindMod guard: without that mod the
         document holds no ProcessorFramework.ProcessDef nodes and the arm simply matches nothing. -->
    <Operation Class="NewHarvestPatches.TestCategory">
        <xpath>/Defs/ThingCategoryDef[parent="Foods" or parent="FoodRaw" or parent="PlantFoodRaw"]</xpath>
        <categoryType>Fungus</categoryType>
        <caseTrue Class="PatchOperationSequence">
            <operations>
                <li Class="NewHarvestPatches.AddCategoryToFilter">
                    <success>Always</success>
                    <categoryType>Fungus</categoryType>
                    <xpath>
                        /Defs/RecipeDef/ingredients/li/filter/categories
                        | /Defs/RecipeDef/fixedIngredientFilter/categories
                        | /Defs/RecipeDef/defaultIngredientFilter/categories
                        | /Defs/ThingDef/building/fixedStorageSettings/filter/categories
                        | /Defs/ThingDef/building/defaultStorageSettings/filter/categories
                        | /Defs/ProcessorFramework.ProcessDef/ingredientFilter/categories
                    </xpath>
                </li>

                <!-- Second half: name our own produce outright in those same filters. The dummy category
                     added above only reaches our defs while this kind's merge setting is ON; with it off
                     the dummy is empty and unparented, and this is what keeps a third-party bench working. -->
                <li Class="NewHarvestPatches.AddOwnDefsToCategoryFilters">
                    <success>Always</success>
                    <categoryType>Fungus</categoryType>
                    <xpath>
                        /Defs/RecipeDef/ingredients/li/filter/categories
                        | /Defs/RecipeDef/fixedIngredientFilter/categories
                        | /Defs/RecipeDef/defaultIngredientFilter/categories
                        | /Defs/ThingDef/building/fixedStorageSettings/filter/categories
                        | /Defs/ThingDef/building/defaultStorageSettings/filter/categories
                        | /Defs/ProcessorFramework.ProcessDef/ingredientFilter/categories
                    </xpath>
                </li>
            </operations>
        </caseTrue>
    </Operation>
</Patch>
