<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- RECIPES -->
    <Operation Class="PatchOperationSequence">
        <operations>
            <!-- SPECIFIC CORE RECIPES -->
            <li Class="PatchOperationAdd">
                <xpath>/Defs/RecipeDef[defName="Make_Kibble"]/ingredients/li/filter/thingDefs[li="Hay"]</xpath>
                <value>
                    <li>VV_FeedCorn</li>
                    <li>VV_FeedWheat</li>
                    <li>VV_FeedBeet</li>
                    <li>VV_BeetPulp</li>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>/Defs/RecipeDef[defName="Make_Kibble"]/fixedIngredientFilter/thingDefs[li="Hay"]</xpath>
                <value>
                    <li>VV_FeedCorn</li>
                    <li>VV_FeedWheat</li>
                    <li>VV_FeedBeet</li>
                    <li>VV_BeetPulp</li>
                </value>
            </li>
            <!-- DISALLOWED -->
            <!-- AddDefsWhereDefPresent also mirrors into fixedIngredientFilter/disallowedThingDefs and
                 defaultIngredientFilter/disallowedThingDefs, replacing what used to be 3 separate ops.
                 It creates the former when absent; the latter it only backfills where the recipe or an
                 ancestor already declares one, since RecipeDef.ResolveReferences fills a null
                 defaultIngredientFilter with a copy of the whole fixedIngredientFilter and writing the node
                 takes that away. The anchor is never written into a disallow list. -->
            <li Class="NewHarvestPatches.AddDefsWhereDefPresent">
                <success>Always</success>
                <xpath>/Defs/RecipeDef/ingredients/li/filter/disallowedThingDefs</xpath>
                <anchor>Hay</anchor>
                <mirrorFixedIngredientFilter>true</mirrorFixedIngredientFilter>
                <mirrorDefaultIngredientFilter>true</mirrorDefaultIngredientFilter>
                <value>
                    <li>VV_AlfalfaHay</li>
                    <li>VV_CloverHay</li>
                    <li>VV_TimothyHay</li>
                </value>
            </li>
            <!-- ALLOWED -->
            <!-- Widening this list flips IngredientCount.IsFixedIngredient from true to false, so the
                 recipe's fixedIngredientFilter - bypassed entirely while the slot was fixed - starts being
                 consulted and would reject "Hay" itself. AddDefsWhereDefPresent compensates for that on its
                 own now, flag or no flag: any ingredients/li/filter/thingDefs it widens gets the hays AND
                 "Hay" written into fixedIngredientFilter, which it creates when absent. The
                 mirrorDefaultIngredientFilter below is intent only, and backfills a defaultIngredientFilter
                 solely where one is already declared - where none is, vanilla copies the (now compensated)
                 fixedIngredientFilter into it. Replaces what used to be 9 separate ops. -->
            <li Class="NewHarvestPatches.AddDefsWhereDefPresent">
                <success>Always</success>
                <xpath>/Defs/RecipeDef/ingredients/li/filter/thingDefs</xpath>
                <anchor>Hay</anchor>
                <mirrorFixedIngredientFilter>true</mirrorFixedIngredientFilter>
                <mirrorDefaultIngredientFilter>true</mirrorDefaultIngredientFilter>
                <value>
                    <li>VV_AlfalfaHay</li>
                    <li>VV_CloverHay</li>
                    <li>VV_TimothyHay</li>
                </value>
            </li>
            <!-- Animal Foods Extended's Grazing Feedstock recipe doesn't work when added to because of its CookMealBase parent,
                 more specifically CookMealBase's specialFiltersToDisallow=AllowPlantFood. -->
            <li Class="PatchOperationFindMod">
                <mods>
                    <li>Animal Foods Extended</li>
                </mods>
                <match Class="PatchOperationSequence">
                    <operations>
                        <li Class="PatchOperationAdd">
                            <xpath>
                                /Defs/RecipeDef
                                [defName="CookFeedstockGrazing" or defName="CookFeedstockGrazingBulk"]
                                /fixedIngredientFilter
                                [thingDefs/li="VV_AlfalfaHay"]
                            </xpath>
                            <value>
                                <specialFiltersToDisallow Inherit="False" />
                            </value>
                        </li>
                        <li Class="PatchOperationAdd">
                            <success>Always</success>
                            <xpath>
                                /Defs/RecipeDef[
                                defName="CookFeedstockGrazing" or
                                defName="CookFeedstockGrazingBulk"]
                                /ingredients/li[filter/categories="PlantFoodRaw"]
                                /filter[not(thingDefs)]
                            </xpath>
                            <value>
                                <thingDefs />
                            </value>
                        </li>
                        <li Class="PatchOperationAdd">
                            <xpath>
                                /Defs/RecipeDef[
                                defName="CookFeedstockGrazing" or
                                defName="CookFeedstockGrazingBulk"]
                                /ingredients/li[filter/categories="PlantFoodRaw"]
                                /filter/thingDefs
                            </xpath>
                            <value>
                                <li>VV_FeedCorn</li>
                                <li>VV_FeedWheat</li>
                                <li>VV_FeedBeet</li>
                                <li>VV_BeetPulp</li>
                            </value>
                        </li>
                        <li Class="PatchOperationAdd">
                            <xpath>
                                /Defs/RecipeDef[
                                defName="CookFeedstockGrazing" or
                                defName="CookFeedstockGrazingBulk"]
                                /fixedIngredientFilter/thingDefs
                            </xpath>
                            <value>
                                <li>VV_FeedCorn</li>
                                <li>VV_FeedWheat</li>
                                <li>VV_FeedBeet</li>
                                <li>VV_BeetPulp</li>
                            </value>
                        </li>
                        <li Class="PatchOperationAdd">
                            <xpath>
                                /Defs/RecipeDef[
                                defName="CookFeedstockGrazing" or
                                defName="CookFeedstockGrazingBulk"]
                                /defaultIngredientFilter/thingDefs
                            </xpath>
                            <value>
                                <li>VV_FeedCorn</li>
                                <li>VV_FeedWheat</li>
                                <li>VV_FeedBeet</li>
                                <li>VV_BeetPulp</li>
                            </value>
                        </li>
                    </operations>
                </match>
            </li>
            <!-- STORAGES -->
            <li Class="NewHarvestPatches.AddDefsWhereDefPresent">
                <success>Always</success>
                <xpath>/Defs/ThingDef/building/fixedStorageSettings/filter/thingDefs</xpath>
                <anchor>Hay</anchor>
                <value>
                    <li>VV_AlfalfaHay</li>
                    <li>VV_CloverHay</li>
                    <li>VV_TimothyHay</li>
                </value>
            </li>
            <!-- Not RecipeDef mirroring - a plain sync of the newly-allowed hays from fixedStorageSettings
                 (the hard ceiling) into defaultStorageSettings (the building's starting checked state), so
                 they show up selected out of the box. No IsFixedIngredient-style trap here: this predicate
                 only fires once the op above has already widened fixedStorageSettings, and both storage
                 settings elements are assumed present already (defaultStorageSettings is base-game-declared
                 on every storage building that has one, never absent-by-omission the way a recipe's
                 fixedIngredientFilter/defaultIngredientFilter can be). -->
            <li Class="PatchOperationAdd">
                <success>Always</success>
                <xpath>
                    /Defs/ThingDef/building
                    [defaultStorageSettings]
                    [fixedStorageSettings/filter/thingDefs/li="VV_AlfalfaHay"]
                    /defaultStorageSettings/filter/thingDefs
                    [not(li="VV_AlfalfaHay")]
                </xpath>
                <value>
                    <li>VV_AlfalfaHay</li>
                    <li>VV_CloverHay</li>
                    <li>VV_TimothyHay</li>
                </value>
            </li>
        </operations>
    </Operation>
</Patch>
