<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="NewHarvestPatches.ConditionalSetting">
        <setting>AddWoodConversionRecipe</setting>
        <!-- No Extended/Expanded Woodworking or Medieval Overhaul check here: the setting carries
             ModRequirement.NoWoodworkingMod + NoMedievalOverhaul, so it is never enabled alongside them. -->
        <caseTrue Class="PatchOperationFindMod">
            <mods>
                <li>VV - New Harvest</li>
                <li>VV - New Harvest: Industrial Crops</li>
            </mods>
            <match Class="PatchOperationAdd">
                <xpath>/Defs/RecipeDef[defName="VV_NHCP_ConvertNewHarvestWoodToWood"]/recipeUsers</xpath>
                <value>
                    <li>CraftingSpot</li>
                </value>
            </match>
        </caseTrue>
    </Operation>
</Patch>